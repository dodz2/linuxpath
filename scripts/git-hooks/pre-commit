#!/bin/bash
# Pre-commit hook: minifie les fichiers JS avant chaque commit
# Le hook échoue si la minification échoue

set -e

echo "🔍 Vérification de la minification JS..."

# Répertoire du projet (racine du repo)
PROJECT_DIR="$(git rev-parse --show-toplevel)"
cd "$PROJECT_DIR"

# Lancer la minification
bash minify.sh

# Vérifier s'il y a des changements dans les .min.js
if ! git diff --quiet -- '*.min.js'; then
  echo "📦 Fichiers .min.js mis à jour, ajout automatique..."
  git add assets/*.min.js
  echo "✅ Fichiers .min.js ajoutés au commit"
else
  echo "✅ Aucun changement dans les fichiers .min.js"
fi
