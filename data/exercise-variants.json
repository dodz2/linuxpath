          "id": "audit-ssh-root",
          "title": "Accès root par SSH",
          "brief": "Un serveur d'administration présente un réglage SSH à qualifier avant remédiation.",
          "correction": "Le rapport établit que PermitRootLogin est actif. La priorité est élevée, mais la modification doit être préparée avec un accès de secours et vérifiée après rechargement de sshd.",
          "vfsOverlay": {
            "paths": {
              "/etc/linuxpath-scenario.json": {
                "type": "file",
                "content": "{\"audit\":{\"path\":\"/etc/ssh/sshd_config\",\"key\":\"sshd_config\",\"index\":61,\"lines\":[\"Warning: PermitRootLogin yes [LP-AUDIT-SSH-001]\",\"Evidence: /etc/ssh/sshd_config: PermitRootLogin yes\",\"Suggestion: establish an alternate admin path, disable root login, reload sshd and retest\"]}}"
              },
              "/etc/ssh": {
                "type": "dir",
                "children": [
                  "sshd_config"
                ]
              },
              "/etc/ssh/sshd_config": {
                "type": "file",
                "content": "Port 22\nPermitRootLogin yes\nPasswordAuthentication yes\n"
              },
              "/var/log/lynis.log": {
                "type": "file",
                "content": "[ LinuxPath — rapport Lynis simulé ]\nWarning: PermitRootLogin yes [LP-AUDIT-SSH-001]\nEvidence: /etc/ssh/sshd_config: PermitRootLogin yes\nSuggestion: establish an alternate admin path, disable root login, reload sshd and retest\nHardening index : 61 (indicateur à interpréter)\n"
              }
            }
          },
          "exercises": {
            "m12-e1": {
              "accepted": [
                "sudo lynis audit system --quick"
