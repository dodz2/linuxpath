      "commands": [
        { "cmd": "ps aux", "desc": "Liste tous les processus en cours", "example": "ps aux | grep nginx" },
        { "cmd": "top", "desc": "Moniteur de processus interactif", "example": "top" },
        { "cmd": "htop", "desc": "Moniteur amélioré (si installé)", "example": "htop" },
        { "cmd": "kill <PID>", "desc": "Arrête un processus par son PID", "example": "kill 1234" },
        { "cmd": "kill -9 <PID>", "desc": "Force l'arrêt immédiat (SIGKILL)", "example": "kill -9 1234" },
        { "cmd": "pkill <nom>", "desc": "Arrête un processus par son nom", "example": "pkill nginx" },
        { "cmd": "bg / fg", "desc": "Envoie en arrière-plan / ramène au premier plan", "example": "bg %1" },
        { "cmd": "jobs", "desc": "Liste les processus en arrière-plan", "example": "jobs" },
