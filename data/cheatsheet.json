{
  "categories": [
    {
      "id": "navigation",
      "label": "Navigation",
      "icon": "📁",
      "commands": [
        { "cmd": "pwd", "desc": "Affiche le répertoire courant", "example": "pwd" },
        { "cmd": "ls", "desc": "Liste les fichiers du répertoire", "example": "ls -lah" },
        { "cmd": "cd <dossier>", "desc": "Change de répertoire", "example": "cd /var/log" },
        { "cmd": "cd ..", "desc": "Remonte d'un niveau", "example": "cd .." },
        { "cmd": "cd ~", "desc": "Retourne dans le home", "example": "cd ~" },
        { "cmd": "cd -", "desc": "Retourne au répertoire précédent", "example": "cd -" },
        { "cmd": "tree", "desc": "Affiche l'arborescence en arbre", "example": "tree -L 2" },
        { "cmd": "du -sh <dossier>", "desc": "Taille d'un dossier", "example": "du -sh /var/log" }
      ]
    },
    {
      "id": "fichiers",
      "label": "Fichiers",
      "icon": "📄",
      "commands": [
        { "cmd": "cat <fichier>", "desc": "Affiche le contenu d'un fichier", "example": "cat /etc/hostname" },
        { "cmd": "less <fichier>", "desc": "Affiche page par page (q pour quitter)", "example": "less /var/log/syslog" },
        { "cmd": "head -n <fichier>", "desc": "Affiche les N premières lignes", "example": "head -20 fichier.log" },
        { "cmd": "tail -n <fichier>", "desc": "Affiche les N dernières lignes", "example": "tail -50 fichier.log" },
        { "cmd": "tail -f <fichier>", "desc": "Suit un fichier en temps réel", "example": "tail -f /var/log/syslog" },
        { "cmd": "touch <fichier>", "desc": "Crée un fichier vide", "example": "touch notes.txt" },
        { "cmd": "cp <src> <dest>", "desc": "Copie un fichier", "example": "cp config.txt config.bak" },
        { "cmd": "cp -r <src> <dest>", "desc": "Copie un dossier récursivement", "example": "cp -r /etc/nginx /backup/" },
        { "cmd": "mv <src> <dest>", "desc": "Déplace ou renomme", "example": "mv old.txt new.txt" },
        { "cmd": "rm <fichier>", "desc": "Supprime un fichier", "example": "rm fichier.tmp" },
        { "cmd": "rm -rf <dossier>", "desc": "Supprime un dossier et son contenu", "example": "rm -rf /tmp/cache/" },
        { "cmd": "mkdir <dossier>", "desc": "Crée un répertoire", "example": "mkdir -p /opt/app/logs" },
        { "cmd": "ln -s <cible> <lien>", "desc": "Crée un lien symbolique", "example": "ln -s /usr/bin/python3 /usr/local/bin/python" },
        { "cmd": "wc -l <fichier>", "desc": "Compte les lignes d'un fichier", "example": "wc -l access.log" }
      ]
    },
    {
      "id": "permissions",
      "label": "Permissions",
      "icon": "🔐",
      "commands": [
        { "cmd": "chmod <mode> <fichier>", "desc": "Change les permissions", "example": "chmod 755 script.sh" },
        { "cmd": "chmod +x <fichier>", "desc": "Rend un fichier exécutable", "example": "chmod +x deploy.sh" },
        { "cmd": "chown <user>:<group> <fichier>", "desc": "Change le propriétaire", "example": "chown www-data:www-data /var/www/" },
        { "cmd": "ls -la", "desc": "Liste avec permissions détaillées", "example": "ls -la /etc/passwd" },
        { "cmd": "stat <fichier>", "desc": "Infos complètes sur un fichier", "example": "stat /etc/shadow" },
        { "cmd": "umask", "desc": "Affiche/définit les permissions par défaut", "example": "umask 022" },
        { "cmd": "sudo <commande>", "desc": "Exécute en tant que root", "example": "sudo apt update" },
        { "cmd": "su - <user>", "desc": "Change d'utilisateur", "example": "su - deploy" },
        { "cmd": "id", "desc": "Affiche l'utilisateur et ses groupes", "example": "id" },
        { "cmd": "groups", "desc": "Affiche les groupes de l'utilisateur courant", "example": "groups" }
      ]
    },
    {
      "id": "processus",
