    {
      "id": "recherche",
      "label": "Recherche",
      "icon": "🔍",
      "commands": [
        { "cmd": "grep <motif> <fichier>", "desc": "Cherche un motif dans un fichier", "example": "grep 'error' /var/log/syslog" },
        { "cmd": "grep -r <motif> <dossier>", "desc": "Recherche récursive dans un dossier", "example": "grep -r 'password' /etc/" },
        { "cmd": "grep -i <motif>", "desc": "Recherche insensible à la casse", "example": "grep -i 'root' /etc/passwd" },
        { "cmd": "grep -v <motif>", "desc": "Exclut les lignes contenant le motif", "example": "grep -v '#' /etc/hosts" },
        { "cmd": "grep -n <motif>", "desc": "Affiche les numéros de ligne", "example": "grep -n 'fail' auth.log" },
        { "cmd": "find <chemin> -name <motif>", "desc": "Cherche des fichiers par nom", "example": "find /var -name '*.log'" },
        { "cmd": "find <chemin> -type f -mtime -7", "desc": "Fichiers modifiés dans les 7 derniers jours", "example": "find /home -type f -mtime -7" },
        { "cmd": "find <chemin> -perm /4000", "desc": "Trouve les fichiers SUID (audit sécurité)", "example": "find / -perm /4000 2>/dev/null" },
        { "cmd": "locate <fichier>", "desc": "Recherche rapide dans la base de fichiers", "example": "locate nginx.conf" },
        { "cmd": "which <commande>", "desc": "Trouve le chemin d'une commande", "example": "which python3" },
        { "cmd": "whereis <commande>", "desc": "Chemin binaire, sources et man page", "example": "whereis bash" }
      ]
    },
    {
