    {
      "id": "scripting",
      "label": "Scripting Bash",
      "icon": "📝",
      "commands": [
        { "cmd": "#!/bin/bash", "desc": "Shebang — déclare un script Bash", "example": "#!/bin/bash" },
        { "cmd": "VAR=\"valeur\"", "desc": "Déclare une variable", "example": "NAME=\"LinuxPath\"" },
        { "cmd": "echo $VAR", "desc": "Affiche la valeur d'une variable", "example": "echo $NAME" },
        { "cmd": "if [ condition ]; then ... fi", "desc": "Condition if/then/fi", "example": "if [ -f fichier.txt ]; then echo 'existe'; fi" },
        { "cmd": "for i in liste; do ... done", "desc": "Boucle for", "example": "for f in *.log; do echo $f; done" },
        { "cmd": "while [ condition ]; do ... done", "desc": "Boucle while", "example": "while [ $i -lt 10 ]; do echo $i; i=$((i+1)); done" },
        { "cmd": "function nom() { ... }", "desc": "Définit une fonction", "example": "function greet() { echo \"Bonjour $1\"; }" },
        { "cmd": "$1, $2, ...", "desc": "Arguments passés au script", "example": "echo \"Arg1: $1\"" },
        { "cmd": "$?", "desc": "Code de retour de la dernière commande", "example": "ls /tmp && echo $?" },
        { "cmd": "cmd1 | cmd2", "desc": "Pipe : passe la sortie de cmd1 à cmd2", "example": "ps aux | grep nginx" },
        { "cmd": "cmd > fichier", "desc": "Redirige la sortie vers un fichier (écrase)", "example": "ls > liste.txt" },
        { "cmd": "cmd >> fichier", "desc": "Ajoute la sortie à la fin d'un fichier", "example": "echo 'log' >> app.log" },
        { "cmd": "cmd 2>/dev/null", "desc": "Supprime les erreurs", "example": "find / -name secret 2>/dev/null" }
      ]
    },
