        { "cmd": "systemctl start|stop|restart <service>", "desc": "Démarre/arrête/redémarre un service", "example": "systemctl restart sshd" },
        { "cmd": "journalctl -u <service>", "desc": "Logs d'un service systemd", "example": "journalctl -u nginx -f" }
      ]
    },
