{
  "m1": [
    {
      "id": "m1-e1",
      "title": "Créer un dossier",
      "desc": "Créez un dossier nommé <code>projets</code> dans le répertoire courant.",
      "accepted": [
        "mkdir projets",
        "mkdir ./projets",
        "mkdir -p projets",
        "mkdir -p ./projets",
        "mkdir -v projets",
        "mkdir -v ./projets",
        "mkdir -pv projets"
      ],
      "hints": [
        "Pensez à la commande pour créer des dossiers.",
        "La commande commence par 'mk'.",
        "Tapez : mkdir projets"
      ],
      "validator": {
        "type": "all",
        "of": [
          {
            "type": "exit_zero"
          },
          {
            "type": "command",
            "name": "mkdir"
          },
          {
            "type": "path_exists",
            "path": "/home/user/projets",
            "kind": "directory"
          }
        ]
      }
    },
    {
      "id": "m1-e2",
      "title": "Afficher le répertoire courant",
      "desc": "Affichez le chemin complet du répertoire dans lequel vous vous trouvez.",
      "accepted": [
        "pwd",
        "pwd -L",
        "pwd -P"
      ],
      "hints": [
        "C'est une commande courte qui affiche le chemin.",
        "La commande contient 3 lettres et signifie 'Print Working Directory'.",
        "Tapez : pwd"
      ],
      "validator": {
        "type": "all",
        "of": [
          {
            "type": "exit_zero"
          },
          {
            "type": "command",
            "name": "pwd"
          },
          {
            "type": "stdout_includes",
            "text": "/home/user"
          }
        ]
      }
    },
    {
      "id": "m1-e3",
      "title": "Naviguer vers le home",
      "desc": "Naviguez vers votre répertoire home (<code>/home/user</code>).",
      "accepted": [
        "cd /home/user",
        "cd ~",
        "cd",
        "cd ~/"
      ],
      "hints": [
        "Utilisez la commande de changement de répertoire.",
        "Le symbole ~ représente votre répertoire home.",
        "Tapez : cd ~ ou cd /home/user"
      ],
      "validator": {
        "type": "all",
        "of": [
          {
            "type": "exit_zero"
          },
          {
            "type": "command",
            "name": "cd"
          },
          {
            "type": "cwd",
            "path": "/home/user"
          }
        ]
      }
    }
  ],
  "m2": [
    {
      "id": "m2-e1",
      "title": "Rendre un script exécutable",
      "desc": "Rendez le fichier <code>scripts/script.sh</code> exécutable.",
      "accepted": [
        "chmod +x scripts/script.sh",
        "chmod +x ./scripts/script.sh",
        "chmod +x /home/user/scripts/script.sh",
        "chmod +x ~/scripts/script.sh",
        "chmod 755 scripts/script.sh",
        "chmod a+x scripts/script.sh",
        "chmod u+x scripts/script.sh"
      ],
      "hints": [
        "Il faut modifier les permissions du fichier.",
        "La commande est 'chmod' et vous devez ajouter le bit d'exécution.",
        "Tapez : chmod +x scripts/script.sh"
      ],
      "validator": {
        "type": "all",
        "of": [
          {
            "type": "exit_zero"
          },
          {
            "type": "command",
            "name": "chmod"
          },
          {
            "type": "perm_includes",
            "path": "/home/user/scripts/script.sh",
            "needle": "x"
          }
        ]
      }
    },
    {
      "id": "m2-e2",
      "title": "Afficher les permissions",
      "desc": "Affichez les permissions détaillées du fichier <code>scripts/script.sh</code>.",
      "accepted": [
        "ls -la scripts/script.sh",
        "ls -l scripts/script.sh",
        "ls -al scripts/script.sh",
        "ls -lh scripts/script.sh",
        "ls -la ./scripts/script.sh",
        "ls -la /home/user/scripts/script.sh"
      ],
      "hints": [
        "Utilisez la commande 'ls' avec des options.",
        "L'option -l affiche les permissions en format long.",
        "Tapez : ls -la scripts/script.sh"
      ],
      "validator": {
        "type": "all",
        "of": [
          {
            "type": "exit_zero"
          },
          {
            "type": "command",
            "name": "ls"
          },
          {
            "type": "stdout_includes",
            "text": "script.sh"
          }
        ]
      }
    }
  ],
