  "m7": [
    {
      "id": "m7-e1",
      "title": "Trouver les binaires SUID",
      "desc": "Listez tous les fichiers avec le bit SUID actif sur le système.",
      "accepted": [
        "find / -perm -4000 -type f 2>/dev/null",
        "find / -perm -4000 -type f",
        "find / -perm /4000 -type f 2>/dev/null",
        "find / -perm /4000 -type f",
        "find / -type f -perm -4000 2>/dev/null",
        "find / -type f -perm /4000 2>/dev/null",
        "find / -type f -perm -4000",
        "find / -type f -perm /4000"
      ],
      "hints": [
        "Utilisez la commande de recherche de fichiers avec un filtre sur les permissions.",
        "La commande est <code>find</code> avec l’option <code>-perm</code>. Le SUID correspond au bit 4000.",
        "Tapez : find / -perm -4000 -type f 2>/dev/null"
      ],
      "validator": {
        "type": "all",
        "of": [
          {
            "type": "exit_zero"
          },
          {
            "type": "command",
            "name": "find"
          },
          {
            "type": "stdout_includes",
            "text": "passwd"
          },
          {
            "type": "args_include",
            "tokens": [
              "/",
              "-perm",
              "-type",
              "f"
            ]
          }
        ]
      }
    },
